; Godot 프로젝트 설정 파일입니다. Godot 에디터에서 이 파일을 열면 프로젝트가 열립니다.

config_version=5

[application]

config/name="얼음땡 프로토타입"
config/version="0.9.0"
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")

[autoload]

GameConfig="*res://scripts/autoload/game_config.gd"
SaveData="*res://scripts/autoload/save_data.gd"
NoiseBus="*res://scripts/autoload/noise_bus.gd"
Net="*res://scripts/autoload/net.gd"
CrashLog="*res://scripts/autoload/crash_log.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]

renderer/rendering_method="forward_plus"
